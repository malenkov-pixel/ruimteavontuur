['Загрузка сохранения...','Сақталған ойын жүктелуде...','Načítání uložené hry...','Loading save...','Spielstand wird geladen...','Chargement de la sauvegarde...','Cargando partida guardada...','Caricamento del salvataggio...','Wczytywanie zapisu...','Opgeslagen spel laden...'],
];

const normalize = text =>
  String(text ?? '').replace(/\s+/g, ' ').trim();

const translations = {};

for (const row of rows) {
  const original = normalize(row[0]);
  if (!original) continue;

  translations[original] = {};

  langs.forEach((lang, index) => {
    translations[original][lang] = row[index] || original;
  });
}

function detectDaveLabLanguage() {
  const saved = localStorage.getItem('siteLanguage');

  if (langs.includes(saved)) {
    return saved;
  }

  return 'ru';
}

function translateDaveLabText(text, lang) {
  const original = normalize(text);
  return translations[original]?.[lang] ?? text;
}

function applyDaveLabLanguage(root = document.body) {
  const lang = detectDaveLabLanguage();

  const walker = document.createTreeWalker(
    root,
    NodeFilter.SHOW_TEXT
  );

  const textNodes = [];

  while (walker.nextNode()) {
    textNodes.push(walker.currentNode);
  }

  for (const node of textNodes) {
    if (!node.nodeValue.trim()) continue;

    if (!node.dataset.originalText) {
      node.dataset.originalText = node.nodeValue;
    }

    node.nodeValue = translateDaveLabText(
      node.dataset.originalText,
      lang
    );
  }

  root.querySelectorAll?.('[placeholder], [title], [aria-label]').forEach(el => {
    for (const attr of ['placeholder', 'title', 'aria-label']) {
      if (!el.hasAttribute(attr)) continue;

      const key = `original${attr}`;

      if (!el.dataset[key]) {
        el.dataset[key] = el.getAttribute(attr);
      }

      el.setAttribute(
        attr,
        translateDaveLabText(el.dataset[key], lang)
      );
    }
  });
}

window.applyDaveLabLanguage = applyDaveLabLanguage;

document.addEventListener('DOMContentLoaded', () => {
  applyDaveLabLanguage();

  const observer = new MutationObserver(mutations => {
    for (const mutation of mutations) {
      for (const node of mutation.addedNodes) {
        if (node.nodeType === Node.ELEMENT_NODE) {
          applyDaveLabLanguage(node);
        } else if (node.nodeType === Node.TEXT_NODE) {
          const lang = detectDaveLabLanguage();
          node.nodeValue = translateDaveLabText(node.nodeValue, lang);
        }
      }
    }
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
});

})();